# Zugangsdaten für den clientseitigen Admin-Dialog.
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD=change-me

# Optional: absoluter, deployment-unabhängiger Speicherpfad auf dem Server.
# UPLOAD_DIR=/var/www/vhosts/example.de/private/uploads

# SMTP-Versand für Tattoo-Anfragen. SMTP_FROM muss beim Anbieter als Absender erlaubt sein.
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kontakt@example.de
SMTP_PASSWORD=change-me
SMTP_FROM=kontakt@example.de
